{
  "info": {
    "name": "night notes. · ЛР15 REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Запусти сайт, задай moderator_password и reader_password во вкладке Variables, затем Run collection. Токены и ID статьи заполняются автоматически. Создаётся одна тестовая статья с обычными уведомлениями сайта; в конце статья удаляется. При остановке выполнения её можно удалить запросом 15. Регистрация читателя: POST /api/register с JSON name, email, password; успешный ответ 201. Пароли и токены перед экспортом коллекции необходимо очистить."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "moderator_email",
      "value": "nightnotes.studio@mail.ru",
      "type": "string"
    },
    {
      "key": "moderator_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "reader_email",
      "value": "test@mail.ru",
      "type": "string"
    },
    {
      "key": "reader_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "moderator_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reader_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "article_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{moderator_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Ответ в JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "pm.test('Нет HTML редиректа', () => pm.expect(pm.response.code).not.to.eql(302));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 · Войти как модератор",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('moderator_token', ''); pm.collectionVariables.set('reader_token', ''); pm.collectionVariables.set('article_id', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Роль moderator и токен', () => { pm.expect(pm.response.json().user.role.name).to.eql('moderator'); pm.expect(pm.response.json().token).to.be.a('string'); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('moderator_token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{moderator_email}}\",\n  \"password\": \"{{moderator_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 · Текущий пользователь",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Профиль без пароля', () => { pm.expect(pm.response.json().role.name).to.eql('moderator'); pm.expect(pm.response.json()).not.to.have.property('password'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/user"
      }
    },
    {
      "name": "03 · Список статей",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Пагинация по 5 статей', () => pm.expect(pm.response.json().articles.per_page).to.eql(5));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/articles"
      }
    },
    {
      "name": "04 · Вторая страница",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Вторая страница и API ссылки', () => { const page=pm.response.json().articles; pm.expect(page.current_page).to.eql(2); pm.expect(page.path).to.include('/api/articles'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/articles?page=2"
      }
    },
    {
      "name": "05 · Ошибка валидации",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
              "pm.test('Ошибки обоих полей', () => { pm.expect(pm.response.json().errors).to.have.property('title'); pm.expect(pm.response.json().errors).to.have.property('description'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"x\",\n  \"description\": \"x\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 · Создать тестовую статью",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('article_id', String(pm.response.json().article.id));",
              "pm.test('Статья сохранена и есть Location', () => { pm.expect(pm.response.json().article.id).to.be.a('number'); pm.expect(pm.response.headers.get('Location')).to.include('/api/articles/'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Проверка API из Postman\",\n  \"description\": \"Эта статья создана через REST API и будет удалена в конце проверки.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 · Прочитать созданную статью",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('article_id')) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Получены статья и комментарии', () => { pm.expect(String(pm.response.json().article.id)).to.eql(pm.collectionVariables.get('article_id')); pm.expect(pm.response.json().article.comments).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/articles/{{article_id}}"
      }
    },
    {
      "name": "08 · Изменить только заголовок (PATCH)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('article_id')) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Заголовок обновлён', () => pm.expect(pm.response.json().article.title).to.eql('Новый заголовок через PATCH'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/articles/{{article_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Новый заголовок через PATCH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 · Обновить всю статью (PUT)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
